<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    控件样式。颜色一律 DynamicResource，主题切换时整本 Light/Dark 换掉，
    这里不用改一个字。

    圆角半径按 IDEA 的量级统一分三档：
      8  = 按钮 / 输入框 / 下拉框 / 列表行
      12 = 浮层（菜单、下拉列表、提示气泡）
      10 = 对话框上的按钮
    以前是 5/6/7/8 混着来，看着不够整；现在同一个东西就一个值。
  -->

  <!-- ============================================ 菜单 -->
  <!--
    菜单这里必须自己画模板。原因：默认的 MenuItem / ContextMenu 模板里，
    下拉那一块用的是系统色（SystemColors.MenuBrush 之类），跟主题没关系，
    所以切到深色后下拉还是一片白。这里把下拉的底色/边框/文字全换成 Brush.*，
    跟窗口其他部分一个路子。

    结构：一个 Border 画条目本身，旁边挂一个 Popup 装子菜单。
    Popup 要 AllowsTransparency="True" 才能吃到圆角和阴影，不然四角是方的。
  -->

  <Style TargetType="Menu">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Panel}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="Padding" Value="2,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Menu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    右键菜单：默认模板也是系统色，自己画一层底。
    外面的留白是留给阴影的（Popup 开了透明，这里的四角不会被刷成黑的）。
  -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <!-- MinWidth 落在这里不是随手加的。去掉它（让内容自己撑开）时，
               外层面板量出来是 0x0，里面每个条目跟着被压到 ~40px 宽，
               菜单文字全成了「Java …」「新建 …」这种截断样。
               有个下限，排版就稳了。 -->
          <Border MinWidth="190" Margin="0,0,10,10" Padding="5"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12" SnapsToDevicePixels="True">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="3"
                                Opacity="0.28" Color="#000000"/>
            </Border.Effect>
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 菜单里的分隔线：默认是刻痕，深色下看着像一条亮线，换成一格淡边框 -->
  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Rectangle Height="1" Margin="8,4,8,4" SnapsToDevicePixels="True"
                     Fill="{DynamicResource Brush.Border}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid SnapsToDevicePixels="True">
            <!-- 条目本体：菜单栏上的顶层项、下拉里的一项，都用这块 -->
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 勾选列（只有 IsChecked 的项才露出来） -->
                <Path x:Name="Check" Grid.Column="0" Width="12" Height="12"
                      Margin="0,0,8,0" Stretch="Uniform" Visibility="Collapsed"
                      Data="M1,6 L4.4,9.6 L11,2.4"
                      Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <!-- 快捷键提示 -->
                <TextBlock x:Name="Gesture" Grid.Column="2"
                           Text="{TemplateBinding InputGestureText}"
                           Margin="26,0,2,0" FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Fg.Dim}"/>
                <!-- 有子菜单时露出的箭头 -->
                <Path x:Name="Arrow" Grid.Column="3" Width="5" Height="9"
                      Margin="14,0,0,0" Stretch="Uniform" Visibility="Collapsed"
                      Data="M0,0 L4,4 L0,8"
                      Stroke="{DynamicResource Brush.Fg.Dim}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
              </Grid>
            </Border>

            <!-- 子菜单。默认模板这块是系统色的白底，换掉。
                 注意：这里不能写 IsItemsHost —— 那是 Panel 上的属性，
                 ItemsPresenter 根本没有，写上去是编译错误（MC3072）。 -->
            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade"
                   Placement="Bottom" VerticalOffset="3"
                   IsOpen="{Binding IsSubmenuOpen,
                                    RelativeSource={RelativeSource TemplatedParent}}">
              <Border MinWidth="200" Margin="0,0,12,12" Padding="5"
                      Background="{DynamicResource Brush.Bg.Raised}"
                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                      CornerRadius="12">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="18" ShadowDepth="2"
                                    Opacity="0.30" Color="#000000"/>
                </Border.Effect>
                <!-- 展开请用 KeyboardNavigation.DirectionalNavigation 而不是
                     IsItemsHost：后者是 Panel 上的属性，ItemsPresenter 根本没有，
                     写上去直接编译不过。 -->
                <ItemsPresenter x:Name="Items"
                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- 下拉里带子菜单的项：箭头露出来，子菜单向右展开 -->
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource Brush.Bg.Hover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Dim}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 顶层的「文件/编辑/…」：选中时给个浅底色，不然看不出点了哪个 -->
  <Style x:Key="TopMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
    <Setter Property="Padding" Value="12,6"/>
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================ 按钮 -->

  <!-- 工具栏按钮：图标 + 文字，扁平无边框，靠背景色表示状态 -->
  <Style x:Key="ToolBtn" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="2,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource Brush.Bg.Hover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Dim}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 主页上的主操作：实心强调色 -->
  <Style x:Key="PrimaryBtn" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="18,11"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 主页上的次操作：描边 -->
  <Style x:Key="GhostBtn" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Panel}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="18,11"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource Brush.Bg.Hover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================ 标签页 -->

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Editor}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <!-- 下划线指示 + 悬停底色，比默认的立体标签干净 -->
  <Style TargetType="TabItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="14,8,14,7"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd" Background="Transparent"
                    CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <Rectangle x:Name="Under" Height="2" VerticalAlignment="Bottom"
                       Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Under" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource Brush.Bg.Editor}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="False"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource Brush.Bg.Hover}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================ 项目树 -->

  <Style TargetType="TreeView">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Panel}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="Padding" Value="6,8"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style TargetType="TreeViewItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="Padding" Value="5,4,10,4"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="IsExpanded" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Border x:Name="Bd" Grid.Row="0" CornerRadius="8" BorderThickness="0"
                    Padding="{TemplateBinding Padding}" Margin="0,0,2,0"
                    Background="Transparent" SnapsToDevicePixels="True">
              <DockPanel>
                <ToggleButton x:Name="Exp" DockPanel.Dock="Left" Focusable="False"
                              Width="14" Height="14" Margin="0,0,3,0"
                              IsChecked="{Binding IsExpanded,
                                          RelativeSource={RelativeSource TemplatedParent},
                                          Mode=TwoWay}"
                              Visibility="Collapsed">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent">
                        <Path x:Name="P" Data="M0,0 L4,3.5 L0,7 Z"
                              Fill="{DynamicResource Brush.Fg.Dim}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="P" Property="Data" Value="M0,0 L7,0 L3.5,5 Z"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <ItemsPresenter x:Name="Items" Grid.Row="1" Visibility="Collapsed"
                            Margin="13,0,0,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="Exp" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Items" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource Brush.Bg.Active}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="False"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource Brush.Bg.Hover}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================ 状态栏 / 列表 -->

  <Style TargetType="StatusBar">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Panel}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
  </Style>

  <!-- 列表行（自带方形选中块，这里换成圆角，跟菜单项一个量级） -->
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="Padding" Value="9,6"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource Brush.Bg.Active}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="False"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource Brush.Bg.Hover}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================ 输入框 -->

  <!--
    对话框里的输入框以前是系统默认模板：方角 + 自己的灰边。这里统一 8px 圆角 +
    主题色，悬停 / 聚焦时描边换成强调色。
    底部的「输出 / 日志」文本框把 Background 设成 Transparent、BorderThickness
    设成 0，走的都是 TemplateBinding，所以那两块照样是「没框也没底」的原样。
  -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="7,5"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush"
                      Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush"
                      Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Dim}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    密码框：上面那条是隐式样式，只命中 TextBox，PasswordBox 不在其中，
    所以直接用会冒出一个直角方框（Agent 设置里的 API Key 就是这样）。
    这里照抄 TextBox 那份：圆角 8、同样的底色/边框色、同样的悬停与聚焦高亮。
    PasswordBox 的内容宿主部件同样叫 PART_ContentHost，模板可以直接沿用。
  -->
  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="7,5"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush"
                      Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush"
                      Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Dim}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 勾选框：系统默认那个是硬直角小方块，换成圆角 + 主题强调色 -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <DockPanel SnapsToDevicePixels="True">
            <Border x:Name="Box" DockPanel.Dock="Left" Width="16" Height="16"
                    Margin="0,0,8,0" VerticalAlignment="Center"
                    CornerRadius="5" BorderThickness="1"
                    Background="{DynamicResource Brush.Bg.Raised}"
                    BorderBrush="{DynamicResource Brush.Border}">
              <Path x:Name="Mark" Data="M2.5,8 L6,11.5 L13.5,4" Stretch="None"
                    Stroke="White" StrokeThickness="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Box" Property="Background"
                      Value="{DynamicResource Brush.Accent}"/>
              <Setter TargetName="Box" Property="BorderBrush"
                      Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Dim}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================ 浮层：气泡提示 -->
  <!--
    工具栏按钮的提示气泡。默认气泡是系统配色的一块白方块（深色主题下很突兀），
    这里换成主题色 + 圆角 + 轻阴影。
  -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,6"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Margin="0,0,8,8" Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" SnapsToDevicePixels="True">
            <Border.Effect>
              <DropShadowEffect BlurRadius="12" ShadowDepth="1"
                                Opacity="0.22" Color="#000000"/>
            </Border.Effect>
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================ 滚动条 -->
  <!--
    IDEA 的滚动条是细窄一条 + 圆角滑块，默认的粗方块在深色下很扎眼。
    这里只留一个圆角滑块，上下两个箭头按钮不要（滚轮 / 拖滑块足够用）。
  -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Width" Value="11"/>
    <Setter Property="MinWidth" Value="11"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
            <Track.Thumb>
              <Thumb Focusable="False">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="5" Margin="2" SnapsToDevicePixels="True"
                            Background="{DynamicResource Brush.Bg.Hover}"/>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="MinHeight" Value="11"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                <Track.Thumb>
                  <Thumb Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="5" Margin="2" SnapsToDevicePixels="True"
                                Background="{DynamicResource Brush.Bg.Hover}"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================ 可折叠区块（设置里的分区标题） -->

  <!--
    标题行单独拎一个模板，让里头的箭头能跟着折叠状态转。
    ToggleButton 的 Content 由外面的 Expander 模板用 TemplateBinding 接到
    Header 上，所以这里只管把它 Presenter 出来。
  -->
  <ControlTemplate x:Key="ExpanderToggleTpl" TargetType="ToggleButton">
    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
            Padding="8,7" SnapsToDevicePixels="True">
      <DockPanel>
        <Path x:Name="Arrow" DockPanel.Dock="Left" Width="6" Height="10"
              Margin="0,0,9,0" VerticalAlignment="Center"
              Data="M0,0 L4,4 L0,8" Stretch="Uniform"
              Stroke="{DynamicResource Brush.Fg.Dim}" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              StrokeLineJoin="Round"/>
        <ContentPresenter VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background"
                Value="{DynamicResource Brush.Bg.Hover}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Arrow" Property="Data" Value="M0,0 L8,0 L4,5 Z"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel SnapsToDevicePixels="True">
            <ToggleButton x:Name="Head" DockPanel.Dock="Top" Focusable="False"
                          Template="{StaticResource ExpanderToggleTpl}"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="Body" ContentSource="Content"
                              Margin="8,2,8,8"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================ 对话框圆角按钮 -->

  <!-- 次按钮：描边 + 圆角，悬停换底色 -->
  <Style x:Key="DlgBtn" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="14,0,14,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Dim}"/>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 主按钮：实心强调色 -->
  <Style x:Key="DlgBtnPrimary" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Opacity" Value="0.9"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    危险按钮：实心红。

    Agent 授权卡片里的「允许执行」用它，不用强调色。
    理由：那一步是放行一条高危命令（rm / 覆盖写 / 删目录），
    按钮的颜色本身就得把代价说出来 —— 蓝色主按钮看着像「继续」，红色才像「后果自负」。
    底色走 Brush.Error，深色主题下自动换成深色主题那份红。
  -->
  <Style x:Key="DlgBtnDanger" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
    <Setter Property="Background" Value="{DynamicResource Brush.Error}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Opacity" Value="0.9"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================ md 预览：视图切换 -->

  <!--
    md 文件右上角那个切换按钮。做成**胶囊**（圆角 13 = 高度 26 的一半），
    而不是 DlgBtn 那个 10 的圆角 —— 它比普通按钮矮（26 vs 32），
    10 的圆角在 26 高上看着还是方的。MinWidth 归零：DlgBtn 的 88 是为
    「取消 / 确定」那种两字按钮定的，这里内容是「图标 + 文字 + 箭头」，
    撑到 88 就空出一大块。
  -->
  <Style x:Key="MdModeBtn" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
    <Setter Property="Height" Value="26"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="10,0,8,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="13" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Hover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    md 拆分时「交换左右」那个只有图标的按钮。直接基于 MdModeBtn（继承它的胶囊
    圆角和 Hover 效果），只是改成 26x26 的正圆、Padding 归零 —— 图标自己居中，
    留着 MdModeBtn 那个 Padding 会把图标挤偏。
  -->
  <Style x:Key="MdSwapBtn" TargetType="Button" BasedOn="{StaticResource MdModeBtn}">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <!-- 切换按钮点开之后，菜单里的每一行 -->
  <Style x:Key="MdMenuItemBtn" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="9,6,14,6"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Hover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================ 标题栏窗口控制按钮 -->

  <!--
    标题栏窗口按钮：mac 那套红绿灯。

    和原来的方块比，两个关键差别：
      1) 圆点本身是有颜色的（黄=最小化 / 绿=最大化 / 红=关闭），
         所以它**不能跟着主题走**，也不能把颜色塞进触发器 —— 认色是这套样式的意义，
         切深色还把黄绿红洗淡了就白搭。颜色由 Chrome.TrafficBtn 直接给 Background。
      2) 圆点里那道符号常态就看得见，鼠标过去圆点再压暗一点。和 mac 一致。

    尺寸：圆点 16、按钮宽 24（圆心间距 24、净间隙 8，间隙这一档是 mac 自己的比例）。
    16 这个数是按标题栏高度换算来的 —— mac 是 28 高的标题栏配 12 的圆点，
    这里标题栏 38 高，等比就是 16。原来给 13，在一排里显得又细又小。

    ⚠️ 符号那个 Path **必须显式给 Width/Height**（这里 8×8），这是踩出来的坑：
       Stretch=None 时 WPF 对 geometry **不做任何平移**，也就是说 geometry 的坐标
       是相对 Path 布局框左上角的绝对坐标。不写死尺寸的话，Path 的布局框只有
       geometry 的 bounds 那么大，而 bounds 是拿掉了 stroke、也不含"设计框"概念的：
         - 最小化那条 y=3.5 的横线，bounds 高度是 0 → 布局框只有 stroke 那么高（1.1），
           横线直接画到框下面 3.5 单位处 → 实测偏下 2px；
         - 最大化方框 bounds 从 (1.3,1.3) 起算 → 实测偏下 1px。
       给了固定 8×8 之后，设计框的 (0,0) 就精确落在 Path 布局框左上角，
       而 8 是偶数、(24-8)/2=8 是整数，符号不会落在半像素上发糊（原来 9 就会）。

    命中测试不用特地开 WindowChrome.IsHitTestVisibleInChrome：
    Chrome 里 WindowChrome.CaptionHeight=0，标题栏是客户区自己画的，
    这些按钮本来就在客户区里。
  -->
  <ControlTemplate x:Key="TrafficBtnTpl" TargetType="Button">
    <Grid Background="Transparent" SnapsToDevicePixels="True">
      <Ellipse Width="16" Height="16" Fill="{TemplateBinding Background}"/>
      <Ellipse x:Name="Shade" Width="16" Height="16" Fill="Black" Opacity="0"/>
      <!--
        符号颜色写死 45% 黑，不跟主题：圆点本身是固定色，符号跟着主题走
        反而会在某一边糊掉。45% 压在黄/绿/红上对比都够，又不会抢过圆点的颜色。
      -->
      <Path x:Name="Mark" Data="{TemplateBinding Content}"
            Width="8" Height="8"
            Stroke="#73000000" StrokeThickness="1.5" Opacity="1"
            Stretch="None" IsHitTestVisible="False"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Shade" Property="Opacity" Value="0.10"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Shade" Property="Opacity" Value="0.22"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="TrafficBtn" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template" Value="{StaticResource TrafficBtnTpl}"/>
  </Style>

  <!-- ============================================ 下拉框 -->
  <!--
    默认 ComboBox 模板用的是系统色，切深色后框体还是一块白的，文字也跟着看不见。
    这里自己画：圆角框 + 主题色 + 主题化的下拉列表。
  -->

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="9,0,26,0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd" CornerRadius="8"
                          Background="{DynamicResource Brush.Bg.Raised}"
                          BorderBrush="{DynamicResource Brush.Border}"
                          BorderThickness="1">
                    <Path x:Name="Arrow" Width="8" Height="5" Margin="0,0,11,0"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Data="M0,0 L4,4 L8,0"
                          Stroke="{DynamicResource Brush.Fg.Dim}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush"
                              Value="{DynamicResource Brush.Accent}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <!--
              可编辑模式（IsEditable="True"）专用的输入框。
              ⚠️ 名字必须是 PART_EditableTextBox —— ComboBox 在 OnApplyTemplate 里
              按这个名字去找它，找到了才会把 ComboBox.Text 的读写接到这个 TextBox 上。
              模板里少了它，IsEditable=true 的下拉框就变成「只读的空壳」：
              代码里 _model.Text = xxx 被直接丢弃（界面上不显示），
              用户选完/敲完之后读 _model.Text 又永远是空串（保存不上）。
              API 设置的「模型」那一栏之前就是这样：选了不显示、保存也留不住。

              下面那行 Style="{x:Null}" 不能省：本项目给 TextBox 定了隐式样式
              （圆角 + 边框），编辑器会被套进去多出一层框，所以这里把它清掉，
              所有外观自己设，做成「贴在 ComboBox 里的一行透明文字」。
            -->
            <TextBox x:Name="PART_EditableTextBox"
                     Margin="{TemplateBinding Padding}"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     FontSize="{TemplateBinding FontSize}"
                     Foreground="{DynamicResource Brush.Fg.Primary}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     CaretBrush="{DynamicResource Brush.Fg.Primary}"
                     SelectionBrush="{DynamicResource Brush.Accent}"
                     Visibility="Hidden"
                     Style="{x:Null}"/>
            <ContentPresenter x:Name="ContentSite"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   Placement="Bottom" VerticalOffset="2"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Margin="0,0,8,8" Padding="5"
                      Background="{DynamicResource Brush.Bg.Raised}"
                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                      CornerRadius="12">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.30" Color="#000000"/>
                </Border.Effect>
                <ScrollViewer>
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <!--
              可编辑和不可编辑是两种完全不同的显示方式，必须显式二选一：
              可编辑时亮出输入框、藏掉只读的那个 ContentPresenter。
              不写这段的话，两者会叠在一起，而且 TextBox 一直 Hidden，
              等于白加了。
            -->
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Muted}"/>
    <Setter Property="Padding" Value="9,6"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource Brush.Bg.Hover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background"
                      Value="{DynamicResource Brush.Bg.Active}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
