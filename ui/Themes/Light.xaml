<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    浅色。所有颜色都走 DynamicResource，切换主题时整本字典换掉即可。

    层次：窗口底（Bg.Base）最灰 → 侧栏/工具条（Bg.Panel）白 →
    编辑区（Bg.Editor）纯白。这样编辑区是画面里最亮的一块，
    眼睛自然落在代码上，跟 IDEA / VS Code 的浅色是一个路子。
  -->

  <Color x:Key="Bg.Base">#F4F5F7</Color>
  <Color x:Key="Bg.Panel">#FFFFFF</Color>
  <Color x:Key="Bg.Editor">#FFFFFF</Color>
  <Color x:Key="Bg.Raised">#FFFFFF</Color>
  <Color x:Key="Bg.Hover">#EFF1F4</Color>
  <Color x:Key="Bg.Active">#E7F0FE</Color>
  <Color x:Key="Border">#E2E5EA</Color>
  <Color x:Key="Fg.Primary">#1F2328</Color>
  <Color x:Key="Fg.Muted">#5F6773</Color>
  <Color x:Key="Fg.Dim">#98A0AA</Color>
  <!-- 弹窗遮罩：主窗口里那个弹窗卡片背后压的一层。
       带透明度的颜色不能直接写进 SolidColorBrush 的 Color 再给 DynamicResource 用，
       所以单独留一个 key，值是整支画刷（见下面 Brush.Scrim）。 -->
  <Color x:Key="Scrim">#66000000</Color>
  <Color x:Key="Accent">#2F6FEB</Color>
  <Color x:Key="Ok">#1F9254</Color>
  <Color x:Key="Error">#D64550</Color>
  <Color x:Key="Warn">#B26A00</Color>

  <!-- 编辑器语法色 -->
  <Color x:Key="Syn.Keyword">#8B1E8B</Color>
  <Color x:Key="Syn.Type">#1E6FBF</Color>
  <Color x:Key="Syn.String">#2E7D32</Color>
  <Color x:Key="Syn.Number">#B26A00</Color>
  <Color x:Key="Syn.Comment">#7A7A7A</Color>
  <Color x:Key="Syn.Plain">#1F2328</Color>

  <SolidColorBrush x:Key="Brush.Bg.Base" Color="{DynamicResource Bg.Base}"/>
  <SolidColorBrush x:Key="Brush.Bg.Panel" Color="{DynamicResource Bg.Panel}"/>
  <SolidColorBrush x:Key="Brush.Bg.Editor" Color="{DynamicResource Bg.Editor}"/>
  <SolidColorBrush x:Key="Brush.Bg.Raised" Color="{DynamicResource Bg.Raised}"/>
  <SolidColorBrush x:Key="Brush.Bg.Hover" Color="{DynamicResource Bg.Hover}"/>
  <SolidColorBrush x:Key="Brush.Bg.Active" Color="{DynamicResource Bg.Active}"/>
  <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Border}"/>
  <SolidColorBrush x:Key="Brush.Fg.Primary" Color="{DynamicResource Fg.Primary}"/>
  <SolidColorBrush x:Key="Brush.Fg.Muted" Color="{DynamicResource Fg.Muted}"/>
  <SolidColorBrush x:Key="Brush.Fg.Dim" Color="{DynamicResource Fg.Dim}"/>
  <SolidColorBrush x:Key="Brush.Scrim" Color="{DynamicResource Scrim}"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Accent}"/>
  <SolidColorBrush x:Key="Brush.Ok" Color="{DynamicResource Ok}"/>
  <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource Error}"/>
  <SolidColorBrush x:Key="Brush.Warn" Color="{DynamicResource Warn}"/>

</ResourceDictionary>
